# PDK and tool locations for the thick-oxide (sg13g2_stdcell_hv) flow.
#
# The standard cells themselves are not in the PDK -- config.yaml points at a
# sibling checkout of the sg13g2_stdcell_hv repository. Only the technology
# LEF, DRC/LVS decks and tool paths come from the PDK.
#
# klayout must be on PATH: the LibreLane Makefile runs through `bash -lc`,
# and several steps shell out to klayout by bare name.

export PDK_ROOT=/foss/pdks
export PDK=ihp-sg13g2
export PATH=/foss/tools/bin:/foss/tools/sak:/foss/tools/klayout:${PATH}
